	measure '€ Real - Vencimento' =
			
			VAR __venc1 = CALCULATE( [€ Real - Receitas], Categoria[Subcategoria] = "Vencimento 1" )
			VAR __venc2 = CALCULATE( [€ Real - Receitas], Categoria[Subcategoria] = "Vencimento 2" )
			VAR result = __venc1 + __venc2
			RETURN result
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
