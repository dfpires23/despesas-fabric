	measure '_CF - Despesa Geral (tooltip)' = ```
			
			VAR __Quebra = UNICHAR(10)
			VAR __ValorTotal = [€ Real - Despesas]
			VAR __NumTransacoes = COUNTROWS( 'Despesas Reais' )
			
			VAR __Prioridade = CONCATENATEX( VALUES(Categoria[Prioridade]), Categoria[Prioridade], ", " )
			
			VAR __TopTransacoes = TOPN( 3, 'Despesas Reais', [€ Real - Despesas], DESC )
			VAR __ListaTop3 = 
			    CONCATENATEX( 
			        __TopTransacoes, 
			        FORMAT('Despesas Reais'[Data], "dd/mm") & " - " & 
			        COALESCE('Despesas Reais'[Descrição], "(S/ Desc.)") & ": " & 
			        FORMAT([€ Real - Despesas], "#,0.00 €"), 
			        __Quebra, 
			        [€ Real - Despesas], DESC 
			    )
			
			RETURN
			    SELECTEDVALUE(Categoria[Subcategoria], SELECTEDVALUE(Categoria[Categoria])) & __Quebra &
			    "Total: " & FORMAT(__ValorTotal, "#,0.00 €") & __Quebra &
			    "Nº Movimentos: " & __NumTransacoes & __Quebra &
			    "Prioridade: " & __Prioridade & __Quebra &
			    "--------------------------------" & __Quebra &
			    "Top 3 Maiores Gastos:" & __Quebra & 
			    __ListaTop3 & __Quebra & 
			    IF(__NumTransacoes > 3, "... (+ " & (__NumTransacoes - 3) & " outros movimentos)", "")
			```
		lineageTag: e7943e35-df8e-401e-9661-bd49479b24a9

