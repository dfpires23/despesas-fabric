		lineageTag: afa30138-6c86-4cce-bb76-5acb9406fbe0

	measure '€ KPI - Margem Disponível' = MAX( 0, [€ Real - Vencimento] - [€ Budget - Essenciais] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 9b80a9da-4ef6-4bfb-a5c7-3aa1082e88e0

	measure '€ Budget - Poupança' =
			
			VAR __Margem = [€ KPI - Margem Disponível]
			RETURN
			    IF( __Margem > 0, __Margem * [% Param - Meta Poupança], 0)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 4d61e120-73af-4feb-b606-68beec281fe8

	measure '€ Budget - Extras' = ```
			
			VAR __Margem = [€ KPI - Margem Disponível]
			RETURN 
			    IF( __Margem > 0, __Margem * [% Param - Meta Extras], [€ Param - Min. Sobrevivência] )
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: f339522a-b1cb-4bc9-b084-04868eb34b37

	measure '€ KPI - Transferência (C. Ordem)' = [€ Budget - Essenciais (C. Ordem)] + [€ Budget - Extras]
